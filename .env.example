# PaperLens environment variables
#
# Copy to .env.local (Next.js) and backend/.env (FastAPI), then fill in.
# Never commit a filled-in copy: .gitignore excludes .env* except examples.
#
# The NEXT_PUBLIC_ prefix is a security boundary, not a naming style (D-019).
# Prefixed variables are inlined into the browser bundle at build time, so a
# secret must NEVER carry that prefix.
#
# Retired from the previous version of this file: SUPABASE_KEY (replaced by an
# explicit publishable/secret split, so privilege is visible at every call site),
# SUPABASE_JWT_SECRET (nothing verified end-user JWTs; an unused secret-shaped
# variable implies a protection that was never built), and UPLOAD_DIR (there is
# no local upload directory now that PDFs live in Supabase Storage).

# ---------------------------------------------------------------------------
# Next.js — safe to expose to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable ("anon") key. Safe in the browser because RLS is what restricts
# access, not the key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# ---------------------------------------------------------------------------
# Next.js — server only. NEVER prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Service-role key: bypasses RLS entirely. Used only by lib/supabase/admin.ts,
# for share-token resolution and job enqueue.
SUPABASE_SECRET_KEY=your_secret_key

# Where the Python processing service listens. The browser must never see this.
PROCESSING_SERVICE_URL=http://127.0.0.1:8000
# Shared secret proving a caller is trusted server code (D-021). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROCESSING_SERVICE_TOKEN=generate_a_long_random_value

# LLM access for answer hints and mock papers. Server-side only (D-023).
# Limits are configurable here rather than hardcoded, so they can change without
# a deploy. The model is pinned rather than "latest" so cached output does not
# drift under a key that assumes stability.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1024
LLM_DAILY_TOKEN_BUDGET=100000

# ---------------------------------------------------------------------------
# FastAPI processing service (backend/.env)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# The service holds the secret key for job-scoped database work and receives no
# end-user credentials (D-021). Same value as SUPABASE_SECRET_KEY above.
SUPABASE_SECRET_KEY=your_secret_key

# Must match PROCESSING_SERVICE_TOKEN above: this is the other end of that check.
PROCESSING_SERVICE_TOKEN=generate_a_long_random_value

# Path to the Tesseract binary. Leave blank to use PATH, or the standard Windows
# install location.
TESSERACT_CMD=

# Verbose per-question rejection logging. Defaults to false: it used to default
# to true, which made debug output the normal case (D-019).
PAPERLENS_DEBUG=false

# Advisory similarity threshold. Unvalidated provisional default (D-024) — it
# must not be presented to users as truth until measured on real papers.
SIMILARITY_THRESHOLD=0.84

# Institution pattern set for extraction. `default` covers KIIT/NITR plus generic
# patterns (D-028).
INSTITUTION_PROFILE=default

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Private bucket. Note `exam-pdfs`, per AGENTS.md — the previous value here said
# `exam-papers`, which disagreed with the spec (D-016).
SUPABASE_STORAGE_BUCKET=exam-pdfs
